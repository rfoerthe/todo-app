{
  "name": "powerboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "bun --hot src/index.ts",
    "app:start": "./start.sh",
    "app:stop": "./stop.sh",
    "clean": "rimraf dist build release .runtime logs",
    "start": "NODE_ENV=production bun src/index.ts",
    "build": "vite build",
    "package:mac": "node scripts/build-macos-dmg.mjs",
    "preview": "vite preview --host 0.0.0.0"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "de.local.powerboard",
    "productName": "PowerBoard",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "dist"
      },
      {
        "from": "build/server",
        "to": "server"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icons/icon.icns",
      "target": [
        "dmg"
      ]
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1",
    "react": "^19",
    "react-dom": "^19",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "rimraf": "^2.6.3",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.11",
    "vite": "^8.0.13"
  }
}
